# ==============================================================================
# QNU — Root .env.example (موحّد للمرجع)
# انسخ هذا الملف إلى .env في الجذر أو إلى server/.env و client/.env بشكل منفصل
# لا ترفع ملفات .env الحقيقية أبداً إلى Git
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/svnu
MONGODB_CONNECT_RETRIES=5
MONGODB_CONNECT_RETRY_DELAY_MS=3000
REDIS_URL=redis://localhost:6379
SCHEDULE_WORKER_CONCURRENCY=1
SCHEDULE_QUEUE_DISABLED=false
AUTO_SCHEDULE_REQUIRE_DEPARTMENT=false

JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
QR_SECRET=replace-with-another-long-random-secret

JSON_BODY_LIMIT=100kb
FORM_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Trust reverse proxy (nginx / Render / Railway) — set to true in production
TRUST_PROXY=false

# Google OAuth
GOOGLE_CLIENT_ID=

# SMTP — required in production (server will exit if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@svnu.edu

# ── Client (build-time only) ───────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=
